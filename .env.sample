# Copy this file to .env and fill in the values before running docker compose up.

# ── SQL Server ────────────────────────────────────────────────────────────────
DB_SA_PASSWORD=YourStrong@Passw0rd   # min 8 chars, must contain upper/lower/digit/symbol
DB_NAME=dashboarddb

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=

# Public URL of the Next.js app (used by NextAuth for redirect URLs in production)
AUTH_URL=http://localhost:3000

# GitHub OAuth app — callback: <AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth app — callback: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
